# Copia este archivo a .env y llena los valores. .env NUNCA se sube a Git
# ni entra a la imagen Docker.

# ----- Servidor -----
PORT=3000
# Origenes extra permitidos por CORS, separados por comas (vacio = solo mismo origen)
CORS_ORIGINS=

# ----- Base de datos PostgreSQL -----
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=cambia_esta_contrasena
DB_NAME=api_agua
# true = aplica migraciones pendientes al arrancar (compose.yaml lo fuerza a true)
DB_RUN_MIGRATIONS=false

# ----- Correo SMTP -----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=tu_correo@gmail.com
MAIL_PASSWORD=tu_contrasena_de_aplicacion_de_gmail
MAIL_FROM="Municipio - Reportes de Agua <tu_correo@gmail.com>"

# Correo de la cuadrilla de mantenimiento que recibe los reportes
MAINTENANCE_EMAIL=cuadrilla@example.com

# ----- AWS S3 (fotografias) -----
AWS_REGION=us-east-1
AWS_S3_BUCKET=nombre-de-tu-bucket
# Opcional: URL base publica (p. ej. CloudFront). Vacio = https://<bucket>.s3.<region>.amazonaws.com
AWS_S3_PUBLIC_URL=
# Credenciales: dejalas vacias si usas `aws configure`/AWS_PROFILE en tu Mac.
# En Docker si hacen falta (usuario IAM con permisos SOLO sobre <bucket>/reports/*).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Tamano maximo de la fotografia en MB
PHOTO_MAX_SIZE_MB=5

# ----- Docker -----
# Usuario de Docker Hub: compose.yaml usa ${DOCKER_USER}/aguafix-api:latest
DOCKER_USER=tu_usuario_de_docker_hub
# Puerto del host donde se publica la API del contenedor
API_PORT=3000
